        <Nullable>warnings</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>EasySoft.Core.AgileConfigClient</Title>
        <Description>EasySoft.Core.AgileConfigClient</Description>
