<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>warnings</Nullable>
        <LangVersion>14</LangVersion>
        <Title>EasySoft.UtilityTools.Standard</Title>
        <Description>EasySoft.UtilityTools.Standard</Description>
        <PackageProjectUrl>https://github.com/kityandhero/EasySoft</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kityandhero/EasySoft</RepositoryUrl>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DocumentationFile>bin\Debug\EasySoft.UtilityTools.Standard.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DocumentationFile>bin\Release\EasySoft.UtilityTools.Standard.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.IO.RecyclableMemoryStream"/>
        <PackageReference Include="Microsoft.Win32.SystemEvents"/>
        <PackageReference Include="NGeoHash"/>
        <PackageReference Include="QRCoder"/>
        <PackageReference Include="RSAExtensions"/>
        <PackageReference Include="SixLabors.Fonts"/>
        <PackageReference Include="SixLabors.ImageSharp"/>
        <PackageReference Include="SixLabors.ImageSharp.Drawing"/>
        <PackageReference Include="Newtonsoft.Json"/>
        <PackageReference Include="System.Drawing.Common"/>
        <PackageReference Include="System.IO.Hashing"/>
        <PackageReference Include="MediatR"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Securities\Certificates"/>
    </ItemGroup>

</Project>
