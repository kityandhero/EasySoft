    </ItemGroup>

    <ItemGroup>
        <Folder Include="Assists"/>
        <Folder Include="Attributes\"/>
        <Folder Include="CacheFactories\"/>
        <Folder Include="CacheKeyGenerators\"/>
        <Folder Include="ConfigAssist\"/>
        <Folder Include="ConfigCollection\"/>
        <Folder Include="Enums\"/>
        <Folder Include="Interceptors\"/>
        <Folder Include="interfaces\"/>
        <Folder Include="Options\"/>
        <Folder Include="Serializers\"/>
    </ItemGroup>

</Project>
