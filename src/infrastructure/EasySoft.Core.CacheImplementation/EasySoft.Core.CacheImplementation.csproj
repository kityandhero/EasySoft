    <ItemGroup>
        <PackageReference Include="AspectCore.Abstractions"/>
        <PackageReference Include="AspectCore.Core"/>
        <PackageReference Include="AspectCore.Extensions.DependencyInjection"/>
        <PackageReference Include="AspectCore.Extensions.Reflection"/>
        <PackageReference Include="Castle.Core"/>
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid"/>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis"/>
