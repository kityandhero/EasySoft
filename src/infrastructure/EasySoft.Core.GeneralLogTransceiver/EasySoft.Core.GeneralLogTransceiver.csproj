<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>warnings</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>EasySoft.Core.GeneralLogTransmitter</Title>
        <Description>EasySoft.Core.GeneralLogTransmitter</Description>
        <PackageProjectUrl>https://github.com/kityandhero/EasySoft</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kityandhero/EasySoft</RepositoryUrl>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DocumentationFile>bin\Debug\EasySoft.Core.GeneralLogTransmitter.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DocumentationFile>bin\Release\EasySoft.Core.GeneralLogTransmitter.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="SlimMessageBus"/>
        <PackageReference Include="SlimMessageBus.Host"/>
        <PackageReference Include="SlimMessageBus.Host.Interceptor"/>
        <PackageReference Include="SlimMessageBus.Host.Memory"/>
        <PackageReference Include="SlimMessageBus.Host.RabbitMQ"/>
        <PackageReference Include="SlimMessageBus.Host.Serialization.Json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\test\EasySoft.Core.Messaging.SlimMessageBus.Test\EasySoft.Core.Messaging.SlimMessageBus.Test.csproj"/>
        <ProjectReference Include="..\EasySoft.Core.Config\EasySoft.Core.Config.csproj"/>
        <ProjectReference Include="..\EasySoft.Core.ExchangeRegulation\EasySoft.Core.ExchangeRegulation.csproj"/>
        <ProjectReference Include="..\EasySoft.Core.Infrastructure\EasySoft.Core.Infrastructure.csproj"/>
        <ProjectReference Include="..\EasySoft.Core.Messaging\EasySoft.Core.Messaging.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Abstractions\"/>
        <Folder Include="BackgroundServices\"/>
        <Folder Include="Enums"/>
    </ItemGroup>

</Project>
