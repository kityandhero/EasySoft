{
  "Kernel": {
    "HttpPort": "5001",
    "HttpsPort": "5002"
  },
  "AdvanceTrace": {
    "Tracing": "true",
    "TrackingSourceName": "EasySoft.Core.Web.Framework.Kernel.Test",
    "OpenTelemetryProtocolEndpoint": "http://localhost:5001/v1/traces"
  },
  "NLog": {
    "InternalLogLevel": "Info",
    "TraceToConsole": "true",
    "DebugToConsole": "true"
  },
  "Cache": {
    "KeyPrefix": "KernelTest",
    "Mode": "redis",
    "Redis": {
      "ConnectionString": "redis.local.com,abortConnect=false"
    }
  }
}   