{
  "Kernel": {
    "HttpPort": "5001",
    "HttpsPort": "5002"
  },
  "AdvanceTrace": {
    "ServiceName": "Framework.Kernel.Test",
    "SourceName": "Console",
    "OpenTelemetryProtocolEndpoint": "http://localhost:4318/v1/traces",
    "Tracing": "true",
    "CapturePayload": "true",
    "SensitiveMasking": "true"
  },
  "NLog": {
    "InternalLogLevel": "Info",
    "TraceToConsole": "true",
    "DebugToConsole": "true"
  },
  "Cache": {
    "KeyPrefix": "KernelTest",
    "Mode": "redis",
    "Redis": {
      "ConnectionString": "redis.local.com,abortConnect=false"
    }
  }
}   